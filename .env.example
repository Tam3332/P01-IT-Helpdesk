# P01 - Mẫu cấu hình môi trường. Sao chép thành .env rồi điền giá trị thật.
# CẢNH BÁO: KHÔNG commit file .env lên Git, chỉ commit .env.example.

# Database PostgreSQL
POSTGRES_DB=p01_db
POSTGRES_USER=p01_admin
# Đặt mật khẩu mạnh, tránh ký tự đặc biệt khó xử lý (như # ' " $)
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# Spring Boot Backend
SPRING_PROFILES_ACTIVE=prod
# validate: schema đã nạp từ database/schema.sql, Hibernate chỉ kiểm tra khớp
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT (ADR-02: Bearer token, hết hạn 15 phút). Sinh khóa: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRATION_MS=900000

# Upload (IA-HD03) - khớp SRS HD04
FILE_UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,docx,xlsx,txt,log

# Frontend (biến lúc build): địa chỉ API tương đối, đi qua Nginx gateway
VITE_API_BASE_URL=/api/v1

# Nginx Gateway
HTTPS_PORT=443

# WAF gateway: DetectionOnly trong lượt đầu. Dùng On sau khi xác nhận ca kiểm thử trên lab.
WAF_RULE_ENGINE=DetectionOnly

# Đề xuất lab PL1: ghi rõ ngưỡng để đối chiếu từng lượt; chưa thay xác nhận SecRS.
WAF_ANOMALY_INBOUND=5
WAF_ANOMALY_OUTBOUND=4

# TLS riêng cho user của image WAF; giữ key cũ để rollback. Không commit key.
WAF_TLS_DIR=./nginx/ssl
